  "globalVariables": {},
  "layout": {
    "direction": "row",
    "first": "3D!mpc_view",
    "second": {
      "direction": "column",
      "first": "RawMessages!advice",
      "second": {
        "direction": "column",
        "first": "Table!mpc_health",
